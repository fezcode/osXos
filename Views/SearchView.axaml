<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:OsXos.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="880" d:DesignHeight="700"
             x:Class="OsXos.Views.SearchView"
             x:DataType="vm:SearchViewModel">

  <Grid RowDefinitions="Auto,*">

    <Border Grid.Row="0"
            Background="{DynamicResource BgTopBar}"
            BorderBrush="{DynamicResource LineSubtle}" BorderThickness="0,0,0,1"
            Padding="24,14">
      <Grid ColumnDefinitions="Auto,*" VerticalAlignment="Center">
        <Border Width="38" Height="38" CornerRadius="9" Margin="0,0,13,0"
                Background="{DynamicResource AccentMuted}"
                BorderBrush="{DynamicResource Line}" BorderThickness="1">
          <PathIcon Data="{StaticResource IconSearch}" Width="17" Height="17"
                    Foreground="{DynamicResource Accent}"/>
        </Border>

        <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
          <TextBlock Text="Search" Classes="h1"/>
          <TextBlock FontSize="12" Classes="muted">
            <Run Text="{Binding CountText}"/><Run Text=" “"/><Run Text="{Binding Query}"/><Run Text="”"/>
          </TextBlock>
        </StackPanel>
      </Grid>
    </Border>

    <ScrollViewer Grid.Row="1">
      <StackPanel Margin="24,18,24,22">

        <!-- The one empty state in osXos. Categories are never empty because they
             are derived from the tools; a search that matches nothing genuinely is. -->
        <Border Classes="card" IsVisible="{Binding !HasResults}" Padding="24,22">
          <StackPanel Spacing="8">
            <TextBlock Text="NO MATCH" Classes="eyebrow"/>
            <TextBlock Text="Nothing here matches that" Classes="h3"/>
            <TextBlock TextWrapping="Wrap" FontSize="12" Classes="muted"
                       Text="Search looks at tool names, what they do and the category they sit in. osXos only ever lists the tools for the operating system it is running on, so a tool that exists in the macOS or Linux build will not appear here."/>
          </StackPanel>
        </Border>

        <ItemsControl ItemsSource="{Binding Cards}" IsVisible="{Binding HasResults}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:ToolCardViewModel">
              <Button Classes="CardHit" Command="{Binding OpenCommand}"
                      HorizontalAlignment="Stretch" Margin="0,0,0,10">
                <Border Classes="card" Padding="16,14">
                  <Grid ColumnDefinitions="Auto,*,Auto,Auto">
                    <Border Width="36" Height="36" CornerRadius="9" Margin="0,0,14,0"
                            Background="{DynamicResource SurfaceHover}"
                            BorderBrush="{DynamicResource Line}" BorderThickness="1"
                            VerticalAlignment="Center">
                      <PathIcon Data="{Binding Icon}" Width="16" Height="16"
                                Foreground="{DynamicResource Accent}"/>
                    </Border>

                    <StackPanel Grid.Column="1" Spacing="3" VerticalAlignment="Center">
                      <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="Bold"
                                 Foreground="{DynamicResource Text}"/>
                      <TextBlock Text="{Binding Summary}" FontSize="12" Classes="muted"
                                 TextWrapping="Wrap"/>
                    </StackPanel>

                    <Border Grid.Column="2" Background="{DynamicResource SurfaceHover}" CornerRadius="5"
                            Padding="8,3" BorderBrush="{DynamicResource Line}" BorderThickness="1"
                            VerticalAlignment="Center" Margin="14,0,0,0">
                      <TextBlock Text="{Binding StepCountText}" FontSize="10" Classes="mono dim"/>
                    </Border>

                    <PathIcon Grid.Column="3" Data="{StaticResource IconChevronRight}"
                              Width="12" Height="12" Foreground="{DynamicResource Dim}"
                              VerticalAlignment="Center" Margin="12,0,2,0"/>
                  </Grid>
                </Border>
              </Button>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>
    </ScrollViewer>
  </Grid>
</UserControl>
