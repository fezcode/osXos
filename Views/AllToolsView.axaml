<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:OsXos.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="880" d:DesignHeight="700"
             x:Class="OsXos.Views.AllToolsView"
             x:DataType="vm:AllToolsViewModel">
  <UserControl.Styles>
    <!-- Rows are denser than category cards: this page is a checklist of every
         tool, and it has to read as one list rather than thirty separate panels. -->
    <Style Selector="Border.row">
      <Setter Property="Background" Value="{DynamicResource Surface}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource Line}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="10"/>
      <Setter Property="Padding" Value="12,10"/>
      <Setter Property="Margin" Value="0,0,0,6"/>
    </Style>
    <Style Selector="Border.row.checked">
      <Setter Property="BorderBrush" Value="{DynamicResource Cyan}"/>
      <Setter Property="Background" Value="{DynamicResource BgElevated}"/>
    </Style>
    <Style Selector="Border.row.idle">
      <Setter Property="Opacity" Value="0.62"/>
    </Style>
    <Style Selector="Border.status">
      <Setter Property="CornerRadius" Value="5"/>
      <Setter Property="Padding" Value="7,2"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
      <Setter Property="Background" Value="{DynamicResource SurfaceHover}"/>
    </Style>
    <Style Selector="Border.status.ok">
      <Setter Property="Background" Value="{DynamicResource GreenMuted}"/>
    </Style>
    <Style Selector="Border.status.bad">
      <Setter Property="Background" Value="{DynamicResource RedMuted}"/>
    </Style>
    <Style Selector="Border.status.busy">
      <Setter Property="Background" Value="{DynamicResource CyanMuted}"/>
    </Style>
  </UserControl.Styles>

  <Panel>
    <Grid RowDefinitions="Auto,*,Auto">

      <!-- ========================================================= -->
      <!-- COMMAND BAR                                               -->
      <!-- ========================================================= -->
      <Border Grid.Row="0"
              Background="{DynamicResource BgTopBar}"
              BorderBrush="{DynamicResource LineSubtle}" BorderThickness="0,0,0,1"
              Padding="24,14">
        <Grid ColumnDefinitions="Auto,*,Auto" VerticalAlignment="Center">
          <Border Width="38" Height="38" CornerRadius="9" Margin="0,0,13,0"
                  Background="{DynamicResource AccentMuted}"
                  BorderBrush="{DynamicResource Line}" BorderThickness="1">
            <PathIcon Data="{StaticResource IconViewGrid}" Width="17" Height="17" Foreground="{DynamicResource Accent}"/>
          </Border>

          <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
            <TextBlock Text="All Tools" Classes="h1"/>
            <TextBlock FontSize="12" Classes="muted">
              <Run Text="{Binding CountText}"/><Run Text=" · "/><Run Text="{Binding OsName}"/><Run Text=" · tick what you want, then Run selected"/>
            </TextBlock>
          </StackPanel>

          <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center" IsVisible="{Binding Scanning}">
              <ProgressBar IsIndeterminate="True" Width="70" Height="3" MinWidth="0" VerticalAlignment="Center"/>
              <TextBlock Text="Checking every tool…" FontSize="11" Classes="muted" VerticalAlignment="Center"/>
            </StackPanel>
            <Button Classes="Modern" Command="{Binding RefreshCommand}" Padding="12,6"
                    ToolTip.Tip="Look again at what every tool would do on this machine. Changes nothing.">
              <StackPanel Orientation="Horizontal" Spacing="6">
                <PathIcon Data="{StaticResource IconRefresh}" Width="11" Height="11" VerticalAlignment="Center"/>
                <TextBlock Text="Refresh" FontSize="12" VerticalAlignment="Center"/>
              </StackPanel>
            </Button>
          </StackPanel>
        </Grid>
      </Border>

      <!-- ========================================================= -->
      <!-- EVERY TOOL, BY CATEGORY                                   -->
      <!-- ========================================================= -->
      <ScrollViewer Grid.Row="1">
        <ItemsControl ItemsSource="{Binding Groups}" Margin="24,16,24,18">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:BatchGroupViewModel">
              <StackPanel Margin="0,0,0,14">
                <StackPanel Orientation="Horizontal" Spacing="8" Margin="2,0,0,8">
                  <PathIcon Data="{Binding Icon}" Width="12" Height="12" Foreground="{DynamicResource Cyan}" VerticalAlignment="Center"/>
                  <TextBlock Text="{Binding Name}" Classes="eyebrow" VerticalAlignment="Center"/>
                </StackPanel>

                <ItemsControl ItemsSource="{Binding Items}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:BatchItemViewModel">
                      <Border Classes="row" Classes.checked="{Binding IsChecked}" Classes.idle="{Binding HasNothingToDo}">
                        <Grid ColumnDefinitions="Auto,Auto,*,Auto,Auto">
                          <CheckBox IsChecked="{Binding IsChecked}" IsEnabled="{Binding IsSelectable}"
                                    VerticalAlignment="Center" Margin="0,0,6,0" MinWidth="0"/>

                          <Border Grid.Column="1" Width="30" Height="30" CornerRadius="8" Margin="0,0,12,0"
                                  Background="{DynamicResource SurfaceHover}"
                                  BorderBrush="{DynamicResource Line}" BorderThickness="1" VerticalAlignment="Center">
                            <PathIcon Data="{Binding Icon}" Width="13" Height="13" Foreground="{DynamicResource Accent}"/>
                          </Border>

                          <StackPanel Grid.Column="2" Spacing="2" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" Spacing="7">
                              <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="SemiBold"
                                         Foreground="{DynamicResource Text}" VerticalAlignment="Center"/>
                              <Border Classes="pill" Classes.on="{Binding State.IsOn}" Classes.partial="{Binding State.IsPartial}"
                                      Classes.unavailable="{Binding State.IsUnavailable}"
                                      IsVisible="{Binding State.HasState}" ToolTip.Tip="{Binding State.Detail}">
                                <TextBlock Text="{Binding State.Label}"/>
                              </Border>
                              <Border Classes="pill readonly" IsVisible="{Binding IsReadOnly}"
                                      ToolTip.Tip="Only reports. Open it from its category to read the report.">
                                <TextBlock Text="Read-only"/>
                              </Border>
                              <Border Classes="pill admin" IsVisible="{Binding NeedsAdmin}"
                                      ToolTip.Tip="Asks for administrator rights when it runs.">
                                <TextBlock Text="Admin"/>
                              </Border>
                            </StackPanel>
                            <TextBlock Text="{Binding StateText}" FontSize="11.5" Classes="muted"
                                       TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis"/>
                            <TextBlock Text="{Binding CoveredText}" FontSize="11" Classes="cyan"
                                       IsVisible="{Binding IsCovered}"/>
                            <TextBlock Text="{Binding ResultText}" FontSize="11" FontWeight="SemiBold" Classes="green"
                                       IsVisible="{Binding Succeeded}"/>
                            <TextBlock Text="{Binding ResultText}" FontSize="11" FontWeight="SemiBold"
                                       Foreground="{DynamicResource Red}" IsVisible="{Binding Failed}"/>
                          </StackPanel>

                          <TextBlock Grid.Column="3" Text="{Binding SizeText}" IsVisible="{Binding HasSize}"
                                     FontSize="11" Classes="mono muted" VerticalAlignment="Center" Margin="12,0,0,0"/>

                          <Border Grid.Column="4" Classes="status" Margin="10,0,0,0" IsVisible="{Binding HasStatus}"
                                  Classes.ok="{Binding Succeeded}" Classes.bad="{Binding Failed}" Classes.busy="{Binding IsRunningNow}">
                            <TextBlock Text="{Binding StatusText}" FontSize="10" FontWeight="SemiBold"
                                       Foreground="{DynamicResource Text}"/>
                          </Border>
                        </Grid>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </ScrollViewer>

      <!-- ========================================================= -->
      <!-- SELECTION BAR                                             -->
      <!-- ========================================================= -->
      <Border Grid.Row="2" Background="{DynamicResource BgTopBar}"
              BorderBrush="{DynamicResource LineSubtle}" BorderThickness="0,1,0,0" Padding="24,12">
        <Grid ColumnDefinitions="*,Auto" VerticalAlignment="Center">
          <StackPanel Spacing="2" VerticalAlignment="Center">
            <TextBlock Text="{Binding SelectionText}" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource Text}"/>
            <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding HasRunSummary}">
              <TextBlock Text="{Binding RunSummary}" FontSize="11" Classes="muted" VerticalAlignment="Center"/>
              <Button Classes="Ghost" Content="View report" Command="{Binding OpenReportCommand}"
                      Padding="6,1" FontSize="11" VerticalAlignment="Center"/>
            </StackPanel>
          </StackPanel>

          <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
            <Button Classes="Ghost" Content="Select all" Command="{Binding SelectAllCommand}" IsEnabled="{Binding !Running}"/>
            <Button Classes="Ghost" Content="Clear" Command="{Binding ClearCommand}" IsEnabled="{Binding !Running}"/>
            <Button Classes="Modern" Content="Stop after this one" Command="{Binding StopCommand}" IsVisible="{Binding Running}"/>
            <Button Classes="Accent" Command="{Binding ReviewCommand}" IsEnabled="{Binding CanRunSelected}">
              <StackPanel Orientation="Horizontal" Spacing="6">
                <PathIcon Data="{StaticResource IconPlay}" Width="11" Height="11" VerticalAlignment="Center"/>
                <TextBlock Text="Run selected" VerticalAlignment="Center"/>
              </StackPanel>
            </Button>
          </StackPanel>
        </Grid>
      </Border>
    </Grid>

    <!-- ========================================================= -->
    <!-- CONFIRM                                                   -->
    <!-- ========================================================= -->
    <Border IsVisible="{Binding ShowConfirm}" Background="#80000000">
      <Border Width="480" MaxHeight="560" Background="{DynamicResource BgElevated}" CornerRadius="12"
              BorderBrush="{DynamicResource LineBright}" BorderThickness="1"
              BoxShadow="0 16 48 #66000000" Padding="24"
              HorizontalAlignment="Center" VerticalAlignment="Center">
        <Grid RowDefinitions="Auto,*,Auto,Auto">
          <TextBlock Text="{Binding ConfirmTitle}" Classes="h2" Margin="0,0,0,12"/>

          <ScrollViewer Grid.Row="1" MaxHeight="220" Margin="0,0,0,12">
            <ItemsControl ItemsSource="{Binding ConfirmNames}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="x:String">
                  <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,2">
                    <Ellipse Width="5" Height="5" Fill="{DynamicResource Cyan}" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding}" FontSize="12.5" Foreground="{DynamicResource Text}"/>
                  </StackPanel>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>

          <ItemsControl Grid.Row="2" ItemsSource="{Binding ConfirmNotes}" Margin="0,0,0,18">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="x:String">
                <TextBlock Text="{Binding}" FontSize="12" Classes="muted" TextWrapping="Wrap" Margin="0,0,0,6"/>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>

          <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
            <Button Classes="Ghost" Content="Cancel" Command="{Binding CancelConfirmCommand}"/>
            <Button Classes="Accent" Content="Run them" Command="{Binding ConfirmCommand}"/>
          </StackPanel>
        </Grid>
      </Border>
    </Border>

    <!-- ========================================================= -->
    <!-- RUN REPORT                                                -->
    <!-- ========================================================= -->
    <Border IsVisible="{Binding ShowReport}" Background="#80000000">
      <Border Width="600" MaxHeight="640" Background="{DynamicResource BgElevated}" CornerRadius="12"
              BorderBrush="{DynamicResource LineBright}" BorderThickness="1"
              BoxShadow="0 16 48 #66000000" Padding="24"
              HorizontalAlignment="Center" VerticalAlignment="Center">
        <Grid RowDefinitions="Auto,Auto,*,Auto">
          <TextBlock Text="RUN REPORT" Classes="eyebrow" Margin="0,0,0,4"/>
          <TextBlock Grid.Row="1" Text="{Binding ReportTitle}" Classes="h2" Margin="0,0,0,14" TextWrapping="Wrap"/>

          <ScrollViewer Grid.Row="2" Margin="0,0,0,16">
            <ItemsControl ItemsSource="{Binding Report}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:BatchReportRow">
                  <Border Classes="row" Padding="12,10">
                    <Grid ColumnDefinitions="Auto,*,Auto">
                      <Border Width="28" Height="28" CornerRadius="7" Margin="0,0,12,0" VerticalAlignment="Top"
                              Background="{DynamicResource SurfaceHover}"
                              BorderBrush="{DynamicResource Line}" BorderThickness="1">
                        <PathIcon Data="{Binding Icon}" Width="12" Height="12" Foreground="{DynamicResource Accent}"/>
                      </Border>

                      <StackPanel Grid.Column="1" Spacing="3">
                        <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource Text}"/>
                        <TextBlock Text="{Binding Headline}" FontSize="12" FontWeight="SemiBold" Classes="green"
                                   TextWrapping="Wrap" IsVisible="{Binding Succeeded}"/>
                        <TextBlock Text="{Binding Headline}" FontSize="12" FontWeight="SemiBold"
                                   Foreground="{DynamicResource Red}" TextWrapping="Wrap" IsVisible="{Binding Failed}"/>
                        <ItemsControl ItemsSource="{Binding Lines}" IsVisible="{Binding HasLines}" Margin="0,2,0,0">
                          <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="x:String">
                              <TextBlock Text="{Binding}" FontSize="11.5" Classes="muted" TextWrapping="Wrap" Margin="0,1"/>
                            </DataTemplate>
                          </ItemsControl.ItemTemplate>
                        </ItemsControl>
                      </StackPanel>

                      <Border Grid.Column="2" Classes="status" Margin="10,0,0,0" VerticalAlignment="Top"
                              Classes.ok="{Binding Succeeded}" Classes.bad="{Binding Failed}">
                        <TextBlock Text="{Binding StatusText}" FontSize="10" FontWeight="SemiBold"
                                   Foreground="{DynamicResource Text}"/>
                      </Border>
                    </Grid>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>

          <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Classes="Accent" Content="Close" Command="{Binding CloseReportCommand}"/>
          </StackPanel>
        </Grid>
      </Border>
    </Border>
  </Panel>
</UserControl>
