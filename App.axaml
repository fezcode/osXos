        <!-- ========================================================= -->
        <!-- EDITORIAL DESIGN SYSTEM: WARM IVORY & FOREST GREEN         -->
        <!-- ========================================================= -->

        <!-- Backdrops -->
        <SolidColorBrush x:Key="Bg0" Color="#FAF7EE"/>
        <SolidColorBrush x:Key="BgSidebar" Color="#183327"/>
        <SolidColorBrush x:Key="BgTopBar" Color="#F4EFE3"/>
        <SolidColorBrush x:Key="BgElevated" Color="#FFFDF9"/>
        <SolidColorBrush x:Key="Surface" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="SurfaceHover" Color="#F2ECE0"/>
        <SolidColorBrush x:Key="SurfaceActive" Color="#E8DFC9"/>

        <!-- Hairline Borders -->
        <SolidColorBrush x:Key="Line" Color="#E5DDCB"/>
        <SolidColorBrush x:Key="LineBright" Color="#D4C9B3"/>
        <SolidColorBrush x:Key="LineSubtle" Color="#F0E9DC"/>

        <!-- Typography -->
        <SolidColorBrush x:Key="Text" Color="#17261F"/>
        <SolidColorBrush x:Key="Muted" Color="#5A6B62"/>
        <SolidColorBrush x:Key="Dim" Color="#8C9B92"/>

        <!-- Accents -->
        <SolidColorBrush x:Key="Accent" Color="#183327"/>
        <SolidColorBrush x:Key="AccentHover" Color="#224535"/>
        <SolidColorBrush x:Key="AccentActive" Color="#10241B"/>
        <SolidColorBrush x:Key="AccentMuted" Color="#26183327"/>
        <SolidColorBrush x:Key="OnAccent" Color="#FFFFFF"/>

        <!-- Highlight Accent (Cyan) -->
        <SolidColorBrush x:Key="Cyan" Color="#D97706"/>
        <SolidColorBrush x:Key="CyanHover" Color="#B45309"/>
        <SolidColorBrush x:Key="CyanMuted" Color="#26D97706"/>

        <!-- Gold -->
        <SolidColorBrush x:Key="Gold" Color="#B45309"/>
        <SolidColorBrush x:Key="GoldHover" Color="#92400E"/>
        <SolidColorBrush x:Key="GoldMuted" Color="#FEF3C7"/>
        <SolidColorBrush x:Key="OnGold" Color="#FFFFFF"/>

        <!-- Green -->
        <SolidColorBrush x:Key="Green" Color="#15803D"/>
        <SolidColorBrush x:Key="GreenHover" Color="#166534"/>
        <SolidColorBrush x:Key="GreenMuted" Color="#DCFCE7"/>
        <SolidColorBrush x:Key="OnGreen" Color="#FFFFFF"/>

        <!-- Red -->
        <SolidColorBrush x:Key="Red" Color="#BE123C"/>
        <SolidColorBrush x:Key="RedHover" Color="#9F1239"/>
        <SolidColorBrush x:Key="RedMuted" Color="#FFE4E6"/>

        <!-- Sidebar Dynamic Brushes -->
        <SolidColorBrush x:Key="SidebarHover" Color="#1F3E30"/>
        <SolidColorBrush x:Key="SidebarSelected" Color="#264738"/>
        <SolidColorBrush x:Key="SidebarBorder" Color="#2B5240"/>
        <SolidColorBrush x:Key="SidebarDivider" Color="#244535"/>

        <!-- Per-OS identity brushes, used by the sidebar badge strip and by any
             tool card that needs to name the platform it belongs to. -->
        <SolidColorBrush x:Key="WindowsBrush" Color="#0284C7"/>
        <SolidColorBrush x:Key="MacOSBrush" Color="#94A3B8"/>
        <SolidColorBrush x:Key="LinuxBrush" Color="#D97706"/>

        <!-- Global Font Family Resource (Dynamic - Bundled Inter Variable) -->
        <FontFamily x:Key="AppFontFamily">avares://Avalonia.Fonts.Inter/Assets#Inter, Aptos, Segoe UI Variable Text, Segoe UI, -apple-system, sans-serif</FontFamily>
        
        <!-- Bundled Luxury Serif Font Family for Brand Logo -->
        <FontFamily x:Key="BrandFontFamily">avares://osXos/Assets/Fonts/PlayfairDisplay.ttf#Playfair Display, Playfair Display, Georgia, Garamond, serif</FontFamily>

        <!-- The sidebar and About lockup. Exo's X is geometric and angular, which is
             the same X the app mark draws, so the wordmark and the icon agree. -->
        <FontFamily x:Key="WordmarkFontFamily">avares://osXos/Assets/Fonts/Exo.ttf#Exo, Exo, Bahnschrift, Segoe UI Variable Display, sans-serif</FontFamily>

        <!-- List Selection Overrides -->
        <SolidColorBrush x:Key="SystemControlHighlightListLowBrush" Color="#1AD97706"/>
        <SolidColorBrush x:Key="SystemControlHighlightListMediumBrush" Color="#26D97706"/>
        <SolidColorBrush x:Key="SystemControlHighlightListAccentLowBrush" Color="#1AD97706"/>
        <SolidColorBrush x:Key="SystemControlHighlightListAccentMediumBrush" Color="#33D97706"/>
        <SolidColorBrush x:Key="SystemControlHighlightListAccentHighBrush" Color="#4DD97706"/>
    </Application.Resources>

    <Application.Styles>
        <FluentTheme />

        <!-- Global Window Typography & Crisp Text Rendering -->
        <Style Selector="Window">
            <Setter Property="FontFamily" Value="{DynamicResource AppFontFamily}"/>
            <Setter Property="Foreground" Value="{DynamicResource Text}"/>
            <Setter Property="UseLayoutRounding" Value="True"/>
            <!-- One step up from Normal. Grayscale antialiasing lays down less ink than
                 ClearType does, so body text at 400 reads thin; 500 restores the weight
                 without looking bold. Headings set their own weight and are unaffected. -->
            <Setter Property="FontWeight" Value="Medium"/>
        </Style>

        <Style Selector="TextBlock">
            <Setter Property="UseLayoutRounding" Value="True"/>
        </Style>

        <!-- ========================================================= -->
        <!-- BUTTONS                                                   -->
        <!-- ========================================================= -->

        <!-- Standard Modern Button -->
        <Style Selector="Button.Modern">
            <Setter Property="Background" Value="{DynamicResource Surface}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Line}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="{DynamicResource Text}"/>
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.12"/>
                    <BrushTransition Property="BorderBrush" Duration="0:0:0.12"/>
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Button.Modern:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource SurfaceHover}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource LineBright}"/>
            <Setter Property="TextElement.Foreground" Value="{DynamicResource Text}"/>
        </Style>
        <Style Selector="Button.Modern:pressed /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource SurfaceActive}"/>
        </Style>
        <Style Selector="Button.Modern:disabled /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource SurfaceHover}"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="TextElement.Foreground" Value="{DynamicResource Dim}"/>
        </Style>

        <!-- Primary Accent Button -->
        <Style Selector="Button.Accent">
            <Setter Property="Background" Value="{DynamicResource Accent}"/>
            <Setter Property="Foreground" Value="{DynamicResource OnAccent}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Accent}"/>
            <Setter Property="Padding" Value="18,8"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.12"/>
                    <BrushTransition Property="BorderBrush" Duration="0:0:0.12"/>
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Button.Accent:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource AccentHover}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource AccentHover}"/>
            <Setter Property="TextElement.Foreground" Value="{DynamicResource OnAccent}"/>
        </Style>
        <Style Selector="Button.Accent:pressed /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource AccentActive}"/>
        </Style>
        <Style Selector="Button.Accent:disabled /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource SurfaceHover}"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="TextElement.Foreground" Value="{DynamicResource Dim}"/>
        </Style>

        <!-- High-Impact Launch Button -->
        <Style Selector="Button.Play">
            <Setter Property="Background" Value="{DynamicResource Accent}"/>
            <Setter Property="Foreground" Value="{DynamicResource OnAccent}"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Accent}"/>
            <Setter Property="Padding" Value="22,11"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.12"/>
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Button.Play:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource AccentHover}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource AccentHover}"/>
            <Setter Property="TextElement.Foreground" Value="{DynamicResource OnAccent}"/>
        </Style>
        <Style Selector="Button.Play:pressed /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource AccentActive}"/>
        </Style>
        <Style Selector="Button.Play:disabled /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource SurfaceHover}"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="TextElement.Foreground" Value="{DynamicResource Dim}"/>
        </Style>

        <!-- Ghost Flat Button -->
        <Style Selector="Button.Ghost">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource Muted}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.12"/>
                    <BrushTransition Property="Foreground" Duration="0:0:0.12"/>
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Button.Ghost:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource SurfaceHover}"/>
            <Setter Property="TextElement.Foreground" Value="{DynamicResource Text}"/>
        </Style>

        <!-- Danger Button -->
        <Style Selector="Button.Danger">
            <Setter Property="Background" Value="{DynamicResource RedMuted}"/>
            <Setter Property="Foreground" Value="{DynamicResource Red}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Red}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style Selector="Button.Danger:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource RedMuted}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource RedHover}"/>
            <Setter Property="TextElement.Foreground" Value="{DynamicResource Red}"/>
        </Style>

        <!-- Icon Button -->
        <Style Selector="Button.Icon">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource Muted}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="Padding" Value="6"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style Selector="Button.Icon:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource SurfaceHover}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Line}"/>
            <Setter Property="TextElement.Foreground" Value="{DynamicResource Text}"/>
        </Style>

        <!-- Window Titlebar Controls -->
        <Style Selector="Button.WindowCtrl">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="7"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Width" Value="28"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style Selector="Button.WindowCtrl:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource SurfaceHover}"/>
        </Style>
        <Style Selector="Button.WindowCtrl:pointerover PathIcon">
            <Setter Property="Foreground" Value="{DynamicResource Text}"/>
        </Style>

        <Style Selector="Button.WindowCloseCtrl">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="7"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Width" Value="28"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style Selector="Button.WindowCloseCtrl:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource RedMuted}"/>
        </Style>
        <Style Selector="Button.WindowCloseCtrl:pointerover PathIcon">
            <Setter Property="Foreground" Value="{DynamicResource Red}"/>
        </Style>

        <!-- View Mode Segment Toggles -->
        <Style Selector="Button.ViewToggle">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="5"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Width" Value="28"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style Selector="Button.ViewToggle:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource SurfaceHover}"/>
        </Style>
        <Style Selector="Button.ViewToggle.active /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource SurfaceHover}"/>
        </Style>
        <Style Selector="Button.ViewToggle.active PathIcon">
            <Setter Property="Foreground" Value="{DynamicResource Cyan}"/>
        </Style>
        <Style Selector="Button.ViewToggle:not(.active) PathIcon">
            <Setter Property="Foreground" Value="{DynamicResource Dim}"/>
        </Style>

        <!-- Text sibling of ViewToggle, for segmented switchers whose options are
             words rather than icons (the Store's Deals | Steam source switch). Same
             anatomy: flat buttons inside a SurfaceHover pill, the active one lifted
             onto the card colour with the accent doing the talking. -->
        <Style Selector="Button.SegText">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style Selector="Button.SegText TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource Dim}"/>
        </Style>
        <Style Selector="Button.SegText:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource BgElevated}"/>
        </Style>
        <Style Selector="Button.SegText.active /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource BgElevated}"/>
        </Style>
        <Style Selector="Button.SegText.active TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource Cyan}"/>
        </Style>

        <!-- Sidebar About Button -->
        <!-- Sidebar collections header: a twisty that points down when expanded -->
        <Style Selector="Button.CollectionHeader">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="12,3"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
        </Style>
        <!-- The sidebar hover styles name the presenter: most palettes pair a dark
             sidebar with the Light theme variant, and Fluent's own pointerover style
             targets ContentPresenter#PART_ContentPresenter — an unnamed selector let
             its light-gray hover through, washing out the sidebar's pale ink. -->
        <Style Selector="Button.CollectionHeader:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource SidebarHover}"/>
        </Style>
        <Style Selector="PathIcon.twisty">
            <Setter Property="RenderTransform" Value="rotate(90deg)"/>
            <Setter Property="Transitions">
                <Transitions>
                    <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.15"/>
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="PathIcon.twisty.collapsed">
            <Setter Property="RenderTransform" Value="rotate(0deg)"/>
        </Style>

        <!-- Sidebar collection row -->
        <Style Selector="Button.Collection">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="12,7"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Foreground" Value="#D0E3DA"/>
        </Style>
        <Style Selector="Button.Collection:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource SidebarHover}"/>
        </Style>
        <Style Selector="Button.Collection TextBlock">
            <Setter Property="Foreground" Value="#D0E3DA"/>
        </Style>

        <Style Selector="Button.SidebarAbout">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style Selector="Button.SidebarAbout:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource SidebarHover}"/>
        </Style>

        <!-- ========================================================= -->
        <!-- PLAIN LIST                                                -->
        <!-- ========================================================= -->

        <!-- A read-only list that virtualizes. An ItemsControl inside a ScrollViewer
             does not: the ScrollViewer hands it infinite height, so it materializes
             every row up front. With a temp folder holding 40,000 entries that froze
             the window outright. ListBox brings its own ScrollViewer and
             VirtualizingStackPanel, and these setters take the selection chrome back
             off so it still reads as a plain list rather than a picker. -->
        <Style Selector="ListBox.plain">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
        </Style>
        <Style Selector="ListBox.plain ListBoxItem">
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0"/>
            <Setter Property="MinHeight" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Focusable" Value="False"/>
        </Style>
        <Style Selector="ListBox.plain ListBoxItem:selected /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent"/>
        </Style>
        <Style Selector="ListBox.plain ListBoxItem:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource SurfaceHover}"/>
        </Style>

        <!-- ========================================================= -->
        <!-- PROGRESS                                                  -->
        <!-- ========================================================= -->

        <Style Selector="ProgressBar.tool">
            <Setter Property="Height" Value="6"/>
            <Setter Property="MinHeight" Value="6"/>
            <Setter Property="CornerRadius" Value="3"/>
            <Setter Property="Background" Value="{DynamicResource Line}"/>
            <Setter Property="Foreground" Value="{DynamicResource Cyan}"/>
        </Style>

        <!-- ========================================================= -->
        <!-- BUTTON ICON INK                                           -->
        <!-- ========================================================= -->

        <!-- A PathIcon does not inherit the button's Foreground. Avalonia's own
             control theme gives PathIcon an explicit Foreground, and an explicit
             value beats an inherited one - so an icon dropped into a dark accent
             button renders in the body ink and disappears against it, while the
             label beside it is correctly white. Every button class that sets its
             own Foreground therefore has to say so again for its icons.

             An icon that sets Foreground on the element itself - the window
             controls, the sidebar chevrons - still wins over these. -->
        <Style Selector="Button.Accent PathIcon">
            <Setter Property="Foreground" Value="{DynamicResource OnAccent}"/>
        </Style>
        <Style Selector="Button.Play PathIcon">
            <Setter Property="Foreground" Value="{DynamicResource OnAccent}"/>
        </Style>
        <Style Selector="Button.Danger PathIcon">
            <Setter Property="Foreground" Value="{DynamicResource Red}"/>
        </Style>
        <Style Selector="Button.Modern PathIcon">
            <Setter Property="Foreground" Value="{DynamicResource Text}"/>
        </Style>
        <Style Selector="Button.Ghost PathIcon">
            <Setter Property="Foreground" Value="{DynamicResource Muted}"/>
        </Style>
        <!-- Ghost lifts its label to Text on hover; the icon follows it. -->
        <Style Selector="Button.Ghost:pointerover PathIcon">
            <Setter Property="Foreground" Value="{DynamicResource Text}"/>
        </Style>

        <!-- ========================================================= -->
        <!-- FORM CONTROLS                                             -->
        <!-- ========================================================= -->

        <Style Selector="TextBox">
            <Setter Property="Background" Value="{DynamicResource Surface}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Line}"/>
            <Setter Property="Foreground" Value="{DynamicResource Text}"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="BorderBrush" Duration="0:0:0.12"/>
                    <BrushTransition Property="Background" Duration="0:0:0.12"/>
                </Transitions>
            </Setter>
        </Style>
        <!-- Fluent renders the watermark at a fixed 50% opacity set as a local value in
             its template, which a style cannot override — so the effective colour is
             always the chosen ink blended halfway into the background, capping contrast
             near 4:1 even with black. Text is therefore the darkest useful choice here.
             Inputs where the hint really matters overlay their own placeholder instead. -->
        <Style Selector="TextBox /template/ TextBlock#PART_Watermark">
            <Setter Property="Foreground" Value="{DynamicResource Text}"/>
        </Style>
        <Style Selector="TextBox:pointerover /template/ Border#PART_BorderElement">
            <Setter Property="BorderBrush" Value="{DynamicResource LineBright}"/>
            <Setter Property="Background" Value="{DynamicResource Surface}"/>
        </Style>
        <Style Selector="TextBox:focus /template/ Border#PART_BorderElement">
            <Setter Property="BorderBrush" Value="{DynamicResource Cyan}"/>
            <Setter Property="Background" Value="{DynamicResource Surface}"/>
        </Style>

        <Style Selector="ComboBox">
            <Setter Property="Background" Value="{DynamicResource Surface}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Line}"/>
            <Setter Property="Foreground" Value="{DynamicResource Text}"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="12,7"/>
            <Setter Property="FontSize" Value="12.5"/>
        </Style>
        <Style Selector="ComboBox:pointerover /template/ Border#Background">
            <Setter Property="BorderBrush" Value="{DynamicResource LineBright}"/>
            <Setter Property="Background" Value="{DynamicResource Surface}"/>
        </Style>
        <Style Selector="ComboBox:focus /template/ Border#Background">
            <Setter Property="BorderBrush" Value="{DynamicResource Cyan}"/>
        </Style>

        <Style Selector="CheckBox">
            <Setter Property="Foreground" Value="{DynamicResource Text}"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <!-- ========================================================= -->
        <!-- MODERN CLEAN TYPOGRAPHY                                   -->
        <!-- ========================================================= -->

        <Style Selector="TextBlock.h1">
            <Setter Property="FontFamily" Value="{DynamicResource AppFontFamily}"/>
            <Setter Property="FontSize" Value="22"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="LetterSpacing" Value="-0.4"/>
            <Setter Property="Foreground" Value="{DynamicResource Text}"/>
        </Style>
        <Style Selector="TextBlock.h2">
            <Setter Property="FontFamily" Value="{DynamicResource AppFontFamily}"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="LetterSpacing" Value="-0.2"/>
            <Setter Property="Foreground" Value="{DynamicResource Text}"/>
        </Style>
        <Style Selector="TextBlock.h3">
            <Setter Property="FontFamily" Value="{DynamicResource AppFontFamily}"/>
            <Setter Property="FontSize" Value="13.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource Text}"/>
        </Style>
        <Style Selector="TextBlock.muted">
            <Setter Property="Foreground" Value="{DynamicResource Muted}"/>
        </Style>
        <Style Selector="TextBlock.dim">
            <Setter Property="Foreground" Value="{DynamicResource Dim}"/>
        </Style>
        <Style Selector="TextBlock.eyebrow">
            <Setter Property="FontSize" Value="10.5"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="LetterSpacing" Value="1.2"/>
            <Setter Property="Foreground" Value="{DynamicResource Cyan}"/>
        </Style>
        <Style Selector="TextBlock.mono">
            <Setter Property="FontFamily" Value="Cascadia Code, Consolas, monospace"/>
        </Style>
        <Style Selector="TextBlock.gold">
            <Setter Property="Foreground" Value="{DynamicResource Gold}"/>
        </Style>
        <Style Selector="TextBlock.green">
            <Setter Property="Foreground" Value="{DynamicResource Green}"/>
        </Style>
        <Style Selector="TextBlock.cyan">
            <Setter Property="Foreground" Value="{DynamicResource Cyan}"/>
        </Style>

        <!-- ========================================================= -->
        <!-- CARDS & CONTAINERS                                        -->
        <!-- ========================================================= -->

        <Style Selector="Border.card">
            <Setter Property="Background" Value="{DynamicResource Surface}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Line}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="20"/>
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="BorderBrush" Duration="0:0:0.12"/>
                    <BrushTransition Property="Background" Duration="0:0:0.12"/>
                </Transitions>
            </Setter>
        </Style>

        <!-- A button that is nothing but a hit target: the Border.card inside supplies
             every pixel of the chrome. Used for the tool cards, where the whole card
             is the click and a separate Run button would only be a smaller version of
             the same target. -->
        <Style Selector="Button.CardHit">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="VerticalContentAlignment" Value="Stretch"/>
        </Style>
        <Style Selector="Button.CardHit /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Padding" Value="0"/>
        </Style>
        <Style Selector="Button.CardHit:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent"/>
        </Style>
        <Style Selector="Button.CardHit:pressed /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent"/>
        </Style>
        <Style Selector="Button.CardHit:pointerover Border.card">
            <Setter Property="Background" Value="{DynamicResource BgElevated}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Cyan}"/>
        </Style>
        <Style Selector="Button.CardHit:pressed Border.card">
            <Setter Property="Background" Value="{DynamicResource SurfaceHover}"/>
        </Style>
        <Style Selector="Border.heroCard">
            <Setter Property="Background" Value="{DynamicResource BgElevated}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource LineBright}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="14"/>
            <Setter Property="Padding" Value="24"/>
        </Style>
        <Style Selector="Border.row">
            <Setter Property="Background" Value="{DynamicResource Surface}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Line}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="14,10"/>
            <Setter Property="Margin" Value="0,2"/>
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.12"/>
                    <BrushTransition Property="BorderBrush" Duration="0:0:0.12"/>
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Border.row:pointerover">
            <Setter Property="Background" Value="{DynamicResource SurfaceHover}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource LineBright}"/>
        </Style>
        <Style Selector="Border.hit">
            <Setter Property="BorderBrush" Value="{DynamicResource Green}"/>
            <Setter Property="Background" Value="{DynamicResource GreenMuted}"/>
        </Style>

        <!-- ========================================================= -->
        <!-- SIDEBAR NAVIGATION                                        -->
        <!-- ========================================================= -->

        <Style Selector="ListBox.nav ListBoxItem">
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Margin" Value="0,2"/>
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style Selector="ListBox.nav ListBoxItem Rectangle.ind">
            <Setter Property="Fill" Value="Transparent"/>
        </Style>
        <Style Selector="ListBox.nav ListBoxItem:selected Rectangle.ind">
            <Setter Property="Fill" Value="{DynamicResource SidebarAccent}"/>
        </Style>
        <Style Selector="ListBox.nav ListBoxItem PathIcon.chevron">
            <Setter Property="Opacity" Value="0"/>
            <Setter Property="Foreground" Value="{DynamicResource SidebarAccent}"/>
        </Style>
        <Style Selector="ListBox.nav ListBoxItem:selected PathIcon.chevron">
            <Setter Property="Opacity" Value="1"/>
            <Setter Property="Foreground" Value="{DynamicResource SidebarAccent}"/>
        </Style>
        <Style Selector="ListBox.nav ListBoxItem:pointerover PathIcon.chevron">
            <Setter Property="Opacity" Value="0.6"/>
            <Setter Property="Foreground" Value="{DynamicResource SidebarAccent}"/>
        </Style>
        <Style Selector="ListBox.nav ListBoxItem:selected">
            <Setter Property="Background" Value="{DynamicResource SidebarSelected}"/>
        </Style>
        <Style Selector="ListBox.nav ListBoxItem TextBlock">
            <Setter Property="Foreground" Value="#D0E3DA"/>
        </Style>
        <Style Selector="ListBox.nav ListBoxItem PathIcon">
            <Setter Property="Foreground" Value="#D0E3DA"/>
        </Style>
        <Style Selector="ListBox.nav ListBoxItem:selected TextBlock">
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style Selector="ListBox.nav ListBoxItem:selected PathIcon">
            <Setter Property="Foreground" Value="{DynamicResource SidebarAccent}"/>
        </Style>
        <Style Selector="ListBox.nav ListBoxItem:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource SidebarHover}"/>
        </Style>

        <!-- ========================================================= -->
        <!-- COVER GRID TILES                                          -->
        <!-- ========================================================= -->

        <!-- Sidebar spectrum stripe: thickens under the pointer so the hover target reads -->
        <Style Selector="Rectangle.stripe">
            <Setter Property="Height" Value="3.5"/>
            <Setter Property="Transitions">
                <Transitions>
                    <DoubleTransition Property="Height" Duration="0:0:0.12"/>
                    <DoubleTransition Property="Opacity" Duration="0:0:0.12"/>
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Border:pointerover > Rectangle.stripe">
            <Setter Property="Height" Value="7"/>
        </Style>
        <Style Selector="Rectangle.stripe">
            <Setter Property="Opacity" Value="0.75"/>
        </Style>
        <Style Selector="Border:pointerover > Rectangle.stripe">
            <Setter Property="Opacity" Value="1"/>
        </Style>
    </Application.Styles>
</Application>
