        <!-- ========================================================= -->
        <!-- osXos ICONS                                               -->
        <!-- ========================================================= -->

        <!-- Brand mark: the "os" tile with the X knocked out of it. F0 selects the
             even-odd fill rule, which is what turns the inner X into a hole rather
             than a second filled shape. Chosen over anything finer because it has to
             survive being drawn at 16px in a taskbar. -->
        <StreamGeometry x:Key="IconBrand">F0 M5 2h14a3 3 0 0 1 3 3v14a3 3 0 0 1-3 3H5a3 3 0 0 1-3-3V5a3 3 0 0 1 3-3zM8.4 6.6L12 10.2L15.6 6.6L17.4 8.4L13.8 12L17.4 15.6L15.6 17.4L12 13.8L8.4 17.4L6.6 15.6L10.2 12L6.6 8.4Z</StreamGeometry>

        <!-- OS marks for the badge strip. The Windows four-pane and a terminal prompt
             for Linux: Tux does not survive being drawn at 14px, and a prompt is the
             mark Linux tooling uses for itself anyway. The Apple mark is Simple Icons
             (CC0), on the same 24x24 grid as everything else here. -->
        <StreamGeometry x:Key="OsWindows">M3 3h8.4v8.4H3zm9.6 0H21v8.4h-8.4zM3 12.6h8.4V21H3zm9.6 0H21V21h-8.4z</StreamGeometry>
